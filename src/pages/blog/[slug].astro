---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProductPicks from '../../components/ProductPicks.astro';
import PostItem from '../../components/PostItem.astro';
import { getPublishedPosts } from '../../lib/posts';
import { categoryName, formatDate, absUrl, getAuthor, authorSchema, initials } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const url = absUrl(`/blog/${post.id}/`);
const modified = d.updatedDate ?? d.pubDate;
const reviewed = d.reviewedDate ?? modified;
const author = getAuthor(d.author);
const authorUrl = `/authors/${author.slug}/`;
const hero = d.heroImage;

const byId = new Map(all.map((p) => [p.id, p]));
const seen = new Set([post.id]);
const related = [
  ...d.related.map((id) => byId.get(id)),
  ...all.filter((p) => p.data.category === d.category),
  ...all,
].filter((p) => p && !seen.has(p.id) && seen.add(p.id)).slice(0, 3);

const jsonLd: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: d.title,
    description: d.description,
    url,
    mainEntityOfPage: url,
    datePublished: d.pubDate.toISOString(),
    dateModified: modified.toISOString(),
    articleSection: categoryName(d.category),
    keywords: [d.keyword, ...d.secondaryKeywords].join(', '),
    about: d.entities.slice(0, 8).map((name) => ({ '@type': 'Thing', name })),
    image: { '@type': 'ImageObject', url: absUrl(hero ?? '/og-default.png'), width: 1200, height: 630 },
    author: authorSchema(author),
    publisher: { '@id': absUrl('/#organization') },
    ...(d.sources.length ? { citation: d.sources.map((s) => ({ '@type': 'CreativeWork', name: s.title, url: s.url })) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: absUrl('/') },
      { '@type': 'ListItem', position: 2, name: categoryName(d.category), item: absUrl(`/category/${d.category}/`) },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.faqs.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
if (d.products.length > 1) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: d.title,
    itemListElement: d.products.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.name })),
  });
}
---
<Base title={d.seoTitle ?? d.title} description={d.description} image={hero} type="article" jsonLd={jsonLd} publishedTime={d.pubDate.toISOString()} modifiedTime={modified.toISOString()}>
  <div class="wrap">
    <header class="article-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href={`/category/${d.category}/`}>{categoryName(d.category)}</a>
      </nav>
      <h1>{d.title}</h1>
      <p class="dek">{d.description}</p>
      <div class="byline">
        <div class="who">
          <span class="avatar">{(author.image || author.type !== 'Person') ? <img src={author.image ?? '/favicon.svg'} alt="" width="40" height="40" /> : initials(author.name)}</span>
          <span>By <a href={authorUrl} rel="author">{author.name}</a></span>
        </div>
        <div class="facts">
          <span>Updated <time datetime={modified.toISOString()}>{formatDate(modified)}</time></span>
          {d.readingTime && <span>{d.readingTime}-minute read</span>}
        </div>
      </div>
      {hero && <img class="hero-img" src={hero} alt={d.heroAlt ?? d.title} width="1200" height="630" fetchpriority="high" decoding="async" />}
    </header>

    <div class="article-layout">
      <article>
        <p class="disclosure">We earn a commission if you buy through links on this page, at no extra cost to you. It never changes what we recommend. <a href="/affiliate-disclosure/">How we make money</a>.</p>
        {d.tldr.length > 0 && (
          <div class="answer">
            <h2>The short answer</h2>
            <ul>{d.tldr.map((t) => <li>{t}</li>)}</ul>
          </div>
        )}
        <ProductPicks products={d.products} />
        <div class="prose">
          <Content />
        </div>

        {d.faqs.length > 0 && (
          <section class="faq" aria-labelledby="faq">
            <h2 id="faq">Questions renters ask</h2>
            {d.faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </section>
        )}

        <section class="trust-box" aria-labelledby="trust">
          <h2 id="trust">Why you can trust this guide</h2>
          <ul>
            <li>Products are checked against manufacturer specifications, installation manuals and long-term owner reports.</li>
            <li>Each pick is scored on our renter criteria: install footprint, reversibility, portability, subscription costs and ecosystem support.</li>
            <li>We never accept payment for placement. Affiliate commissions do not affect rankings.</li>
          </ul>
          <p>Last reviewed <time datetime={reviewed.toISOString()}>{formatDate(reviewed)}</time>. Read our <a href="/how-we-research/">research process</a> and <a href="/editorial-policy/">editorial policy</a>, or <a href="/contact/">report an error</a>.</p>
        </section>

        {d.sources.length > 0 && (
          <section class="sources" aria-labelledby="sources">
            <h2 id="sources">Sources</h2>
            <ol>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.title}</a></li>)}</ol>
          </section>
        )}

        <div class="author-box">
          <span class="avatar">{(author.image || author.type !== 'Person') ? <img src={author.image ?? '/favicon.svg'} alt="" width="56" height="56" /> : initials(author.name)}</span>
          <div>
            <h2><a href={authorUrl} style="color:inherit">{author.name}</a></h2>
            <p class="role">{author.role}</p>
            <p>{author.bio}</p>
          </div>
        </div>
      </article>

      <aside>
        {toc.length > 1 && (
          <nav class="toc" aria-label="Table of contents">
            <h2>In this guide</h2>
            <ol>
              {d.products.length > 0 && <li><a href="#top-picks">Our picks</a></li>}
              {toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
              {d.faqs.length > 0 && <li><a href="#faq">Questions renters ask</a></li>}
            </ol>
          </nav>
        )}
      </aside>
    </div>

    {related.length > 0 && (
      <section class="section">
        <div class="section-head"><h2>Related guides</h2></div>
        <div class="posts">{related.map((p) => <PostItem post={p!} />)}</div>
      </section>
    )}
  </div>
</Base>

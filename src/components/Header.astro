---
import Logo from './Logo.astro';
import { SITE } from '../lib/site';
import { getPublishedPosts } from '../lib/posts';
const used = new Set((await getPublishedPosts()).map((p) => p.data.category));
const extra = SITE.categories.filter((c) => ['baby-proofing', 'kitchen-bath', 'storage-decor', 'home-office', 'pets'].includes(c.slug) && used.has(c.slug));
const path = Astro.url.pathname;
const links = [
  { href: '/category/smart-locks/', label: 'Locks' },
  { href: '/category/security/', label: 'Cameras' },
  { href: '/category/climate/', label: 'Climate' },
  { href: '/category/lighting/', label: 'Lighting' },
  { href: '/category/plugs-power/', label: 'Plugs' },
  { href: '/category/guides/', label: 'Renter guides' },
];
---
<header class="site-header">
  <div class="wrap">
    <Logo />
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
      <a href="/search/" class="nav-search" aria-label="Search guides">Search</a>
    </nav>
    <details class="menu">
      <summary>Menu</summary>
      <div class="menu-panel">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
        <a href="/category/hubs-voice/">Hubs and voice assistants</a>
        {extra.map((c) => <a href={`/category/${c.slug}/`}>{c.name}</a>)}
        <a href="/blog/">All guides</a>
        <a href="/renter-checklist/">The renter checklist</a>
        <a href="/search/">Search</a>
        <a href="/about/">About us</a>
      </div>
    </details>
  </div>
</header>

{
  "name": "rentersmarthome",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "RenterSmartHome.us - renter-friendly smart home guides, built with Astro and an agentic content pipeline.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
